#include "Cmm.h"
#define C_ bits8
#define I_ W_
#define ptr W_

// Note [Future work]
// ~~~~~~~~~~~~~~~~~~
//
// * Declare 'aligned_alloc' or equivalent instead of assuming presence
//
// * Rewrite using custom heap allocator to avoid interference with other foreign allocations

// Given argument @n@,
// allocates @n@ bytes on the foreign heap at address @p@,
// returning @p@
allocAddrBytesPrimOp ( I_ n ) {
    ptr p;
    (p) = ccall malloc(n);
#if DAPOS
    ccall debug_allocAddrBytesPrimOp(n, p);
#endif
    return (p);
}

// Given arguments @n@, @d@,
// allocates @n@ bytes of alignment @d@ bytes on the foreign heap at address @p@,
// returning @p@
allocAddrBytesAlignedPrimOp ( I_ n, I_ d ) {
    ptr p;
    (p) = ccall aligned_alloc(d, n);
#if DAPOS
    ccall debug_allocAddrBytesAlignedPrimOp(n, d, p);
#endif
    return (p);
}

// Given argument @n@,
// allocates @n@ zeroed bytes on the foreign heap at address @p@,
// returning @p@
callocAddrBytesPrimOp ( I_ n ) {
    ptr p;
    (p) = ccall calloc(n, 1);
#if DAPOS
    ccall debug_callocAddrBytesPrimOp(n, p);
#endif
    return (p);
}

// Given arguments @n@, @d@,
// allocates @n@ zeroed bytes of alignment @d@ bytes on the foreign heap at address @p@,
// returning @p@
callocAddrBytesAlignedPrimOp ( I_ n, I_ d ) {
    ptr p;
    (p) = ccall aligned_alloc(d, n);
    // The last argument must be statically known:
    prim %memset(p, 0x00, n, ALIGNMENT_VOID_P);
#if DAPOS
    ccall debug_callocAddrBytesAlignedPrimOp(n, d, p);
#endif
    return (p);
}

// Given arguments @p@, @n@,
// resizes @p@\'s allocation to @n@ bytes at address @q@,
// returning @q@
reallocAddrBytesPrimOp ( ptr p , I_ n ) {
    ptr q;
    (q) = ccall realloc(p, n);
#if DAPOS
    ccall debug_reallocAddrBytesPrimOp(p, n, q);
#endif
    return (q);
}

// Given argument @p@,
// frees @p@\'s allocation
freeAddrPrimOp ( ptr p ) {
#if DAPOS
    ccall debug_freeAddrPrimOp(p);   
#endif 
    ccall free(p);
    return ();
}

// Given arguments @p@, @n@, @c@
// sets the first @n@ bytes off @p@ to @c@
setAddrBytesPrimOp ( ptr p, I_ n, C_ c ) {
#if DAPOS
    ccall debug_setAddrBytesPrimOp(p, n, c);
#endif
    prim %memset(p, c, n, 1);
    return ();
}

// Given arguments @p_src@, @p_dst@, @n@,
// copies the first @n@ bytes off @p_src@ to the first @n@ bytes off @p_dst@,
// where the two ranges may overlap
copyAddrBytesPrimOp ( ptr p, ptr q, I_ n ) {
#if DAPOS
    ccall debug_copyAddrNonOverlappingBytesPrimOp(p, q, n);
#endif
    prim %memmove(q, p, n, 1);
    return ();
}

// Given arguments @p_src@, @p_dst@, @n@,
// copies the first @n@ bytes off @p_src@ to the first @n@ bytes off @p_dst@,
// where the two ranges may not overlap
copyAddrNonOverlappingBytesPrimOp ( ptr p, ptr q, I_ n ) {
#if DAPOS
    ccall debug_copyAddrNonOverlappingBytesPrimOp(p, q, n);
#endif
    prim %memcpy(q, p, n, 1);
    return ();
}