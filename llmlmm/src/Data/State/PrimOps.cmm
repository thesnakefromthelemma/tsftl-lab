// Note [Future work]
// ~~~~~~~~~~~~~~~~~~
//
// * 'noPrimOp' is inlined and optimized away by the NCG backend
//
// * 'noPrimOp' is inlined and optimized away by the LLVM backend

// Given no arguments,
// returns nothing\;
// hack used to refresh State# tokens
// that should be opaque to core
// and immediately compile to a no-op during codegen
// (but I have not yet verified this!)
noPrimOp ( ) {
    return ();
}