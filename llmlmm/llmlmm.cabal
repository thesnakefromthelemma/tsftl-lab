cabal-version:       3.0
build-type:          Simple

name:                tsftl-lab-llmlmm
version:             0.1.0.0
category:            math
synopsis:            Low-level (i.e., representation polymorphic) manual/linear memory management

author:              thesnakefromthelemma
maintainer:          rafayaashary01@gmail.com
license:             BSD-3-Clause
license-file:        ../LICENSE

extra-doc-files:     README.md

source-repository    head
    type:            git
    location:        https://github.com/thesnakefromthelemma/tsftl-lab/llmlmm


-- * Common

common                   common

    build-depends:       base >= 4.21 && < 4.23

    default-language:    Haskell2010

    ghc-options:         -Wall
                         -fexpose-all-unfoldings
                         -fspecialize-aggressively
                         -O2


-- * Library

library

    import:             common

    build-depends:      template-haskell >= 2.23 && < 2.25

    hs-source-dirs:     src

    c-sources:          src/Data/AddrPrimOps.cmm

    exposed-modules:    Data.RuntimeRep
                        Prelude.Linear
                        Data.State
                        Data.State.Linear
                        Data.Addr
                        Data.Addr.Linear
    
    other-modules:      Prelude.Linear.TH
                        Data.Addr.TH
                        Data.Addr.Linear.TH


-- * Tests

test-suite             test

    import:            common

    build-depends:     tsftl-lab-llmlmm

    hs-source-dirs:    test

    main-is:           Main.hs

    type:              exitcode-stdio-1.0

    other-modules:     Ramanujan


-- * Benchmarks

test-suite             bench

    import:            common

    build-depends:     tsftl-lab-llmlmm

    hs-source-dirs:    bench

    main-is:           Main.hs

    type:              exitcode-stdio-1.0