cabal-version:       3.0
build-type:          Simple

name:                tsftl-lab-llmlmm
version:             0.1.0.0
category:            math
synopsis:            Low-level (i.e., representation polymorphic) manual/linear memory management

author:              thesnakefromthelemma
maintainer:          rafayaashary01@gmail.com
license:             BSD-3-Clause
license-file:        ../LICENSE

extra-doc-files:     README.md
                     src/AllocBytes-Old.hs

source-repository    head
    type:            git
    location:        https://github.com/thesnakefromthelemma/tsftl-lab/llmlmm


-- * Common

common                   common

    build-depends:       base >= 4.21 && < 4.23

    default-language:    Haskell2010

    ghc-options:         -Wall
                         -fexpose-all-unfoldings
                         -fspecialize-aggressively
                         -O2


-- * Library

library

    import:             common

    hs-source-dirs:     src

    build-depends:      template-haskell >= 2.23 && < 2.25
                 ,      primitive >= 0.9.1 && < 0.10
                 ,      linear-base >= 0.5 && < 0.6

    c-sources:          src/AllocBytesPrimOps.cmm

    exposed-modules:    Prelude.Linear
                        Data.State
                        Data.State.Linear
                        Data.Addr
                        Data.Addr.Linear
                        AllocBytes
                        AllocBytes.Linear
    
    other-modules:      Data.RuntimeRep.Extra
                        Prelude.Linear.Internal
                        Data.Addr.Internal
                        Data.Addr.Linear.Internal